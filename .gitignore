# --- 密钥 ----------------------------------------------------------------------
# 真实值放在 .env（永不提交），.env.example 列出变量名。
.env
.env.*
!.env.example
*.pem
*.key

# --- 数据 ----------------------------------------------------------------------
# 样本数据属于客户，永不提交。见 data/README.md。
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
*.xlsx
*.xls
*.csv

# --- 编辑器 / 操作系统 ---------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Agent 工具：仅限本地的文件 ------------------------------------------------
# 共享的 Agent 配置在 AGENTS.md 和 .agents/ 中，个人设置留在本地。
.claude/settings.local.json
.claude/worktrees/

# --- Python --------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Node ----------------------------------------------------------------------
node_modules/
.next/
.turbo/

# --- 运行时产物 ----------------------------------------------------------------
*.log
*.sqlite
*.sqlite3
*.db
