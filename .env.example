# 复制为 .env 并填入真实值。永远不要提交 .env。
# 应用读取的每个变量都必须列在这里，附注释，不填真实值。
# tests/test_config.py 会检查这里与 backend/copilot/config.py 一致。

# --- LLM：任意 OpenAI 兼容端点（D-010）----------------------------------------
# 例如 https://api.openai.com/v1、https://api.deepseek.com/v1、http://localhost:11434/v1（Ollama）。
LLM_BASE_URL=
LLM_API_KEY=
# 结构化输出模式：json_schema | json_object | none。选服务商支持的最严格的一种。
# 无论选哪种，输出都会用 Pydantic 校验，失败时把错误反馈给模型重试。
LLM_JSON_MODE=json_object
# 单次请求超时（秒）。
LLM_TIMEOUT_SECONDS=60
# 输出未通过校验时的最大重试次数。
LLM_MAX_RETRIES=2
# 可选：请求的服务等级，作为 service_tier 放在请求体中（例如 OpenRouter）。
# default | flex | priority，留空则不发送。flex 更便宜、优先级更低；OpenRouter 上没有 flex 端点的模型
# 按标准价格处理，不报错。不适用于 embedding。
LLM_SERVICE_TIER=
# 可选：把每次 LLM 调用的消息和回复写成 JSONL，用于调试 prompt（#6）。日志含有客户数据，
# 只能放在被 git 忽略的目录中，例如 data/logs/llm。留空则不写。
LLM_LOG_DIR=

# 每个任务使用的模型。用到某个任务时必须填写。
LLM_MODEL_ANALYZE=
LLM_MODEL_DRAFT=
LLM_MODEL_BACKTRANSLATE=
# 评测（#7）中的评审模型。建议与起草模型来自不同服务商，避免模型给自己打分。
LLM_MODEL_JUDGE=
# 知识库模板的标注（#5，copilot kb annotate）：离线批处理，调用次数少，可以用较强的模型。
LLM_MODEL_ANNOTATE=

# 可选：为某个任务单独指定端点和 key。留空则使用上面的 LLM_BASE_URL 和 LLM_API_KEY。
LLM_BASE_URL_ANALYZE=
LLM_BASE_URL_DRAFT=
LLM_BASE_URL_BACKTRANSLATE=
LLM_BASE_URL_JUDGE=
LLM_BASE_URL_ANNOTATE=
LLM_API_KEY_ANALYZE=
LLM_API_KEY_DRAFT=
LLM_API_KEY_BACKTRANSLATE=
LLM_API_KEY_JUDGE=
LLM_API_KEY_ANNOTATE=

# --- Embedding：OpenAI 兼容的 /v1/embeddings -----------------------------------
# 端点和 key 留空则使用 LLM_BASE_URL 和 LLM_API_KEY。很多聊天服务商不提供 embedding，届时需要单独填写。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- 起草与分流（#6）-----------------------------------------------------------
# 自动发送要求的最低意图分类置信度与草稿信心值（0–1，#7 校准，D-017）。
DRAFT_AUTO_SEND_MIN_CONFIDENCE=0.92
# 表单问题发生时间只有时刻（HH:MM）没有日期时，向前估计的回看天数。
DRAFT_PROBLEM_TIME_LOOKBACK_DAYS=7
# “流水线 + 工具”模式（copilot draft --tools）中，模型最多调用几次只读工具（1–10）。
# 用完后仍没有给出答复时回退到固定流水线。
DRAFT_MAX_TOOL_STEPS=4

# --- 数据与存储 ----------------------------------------------------------------
# 原始样本表格的路径（见 data/README.md）。
SAMPLE_DATA_PATH=data/raw/脱敏数据2026.2.10.xlsx
# SQLAlchemy 数据库 URL。默认是 data/ 下的 SQLite 文件（已被 git 忽略）。
DATABASE_URL=sqlite:///data/copilot.db
