# Copy to .env and fill in real values. Never commit .env.
# Every variable the app reads must be listed here, with a comment, and no real value.

# --- LLM provider ------------------------------------------------------------
# API key for the LLM used for translation, classification and drafting.
ANTHROPIC_API_KEY=

# --- Data --------------------------------------------------------------------
# Path to the raw sample workbook (see data/README.md).
SAMPLE_DATA_PATH=data/raw/脱敏数据2026.2.10.xlsx
