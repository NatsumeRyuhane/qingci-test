# 部署参数。复制为 deploy/.env 后按需修改，全部可选。永远不要提交 deploy/.env。
# 应用配置和密钥不在这里，写在仓库根目录的 .env 中（模板：.env.example）。
# docker compose 会自动读取本目录的 .env；deploy/manage.py 也读取它。

# 对外端口。
COPILOT_PORT=8080
# 监听地址。默认只监听本机；在内网中使用时设为 0.0.0.0 或内网 IP。
# 在访问控制（#13）完成之前，不要把服务暴露到公网。
COPILOT_BIND=127.0.0.1
# 数据目录（数据库、样本数据、备份），相对于 deploy/。默认是仓库的 data/。
COPILOT_DATA_DIR=../data
# 后端容器以哪个用户运行。留空时 manage.py 使用数据目录的属主，一般不需要填写。
# 直接用 docker compose 命令时，填写数据目录属主的 `id -u` 和 `id -g`。
COPILOT_UID=
COPILOT_GID=
